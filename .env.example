# ==============================================================================
# YoloTrips Environment Configuration
# ==============================================================================

# Admin Session Secret (Required: minimum 32 random characters for iron-session)
ADMIN_SESSION_SECRET=dev-secret-key-min-32-chars-long-yolotrips-production

# Public Base URL (Used for sitemap and email redirection links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# P1: Transactional Emails (Resend)
# Leave empty or with dummy key to use built-in mock email logging
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_api_key_here

# ------------------------------------------------------------------------------
# P2: Payment Gateway (Midtrans Snap Sandbox)
# Leave empty to use built-in mock payment confirmation
# ------------------------------------------------------------------------------
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# ------------------------------------------------------------------------------
# P3: WhatsApp Automation (Fonnte API)
# Get your device token at https://fonnte.com
# Leave empty or set to 'mock' to use built-in terminal mock logging
# ------------------------------------------------------------------------------
FONNTE_TOKEN=your-fonnte-token-here
